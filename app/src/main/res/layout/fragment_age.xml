<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="vertical"
    tools:context=".presentation.shareDataBetweenFrag.EnterYourNameFragment">

    <EditText
        android:id="@+id/your_age"
        android:layout_width="match_parent"
        android:layout_height="56.dp"
        android:layout_marginHorizontal="24.dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/custom_edit_text_background"
        android:hint="Enter Your Age"
        android:inputType="number"
        android:paddingHorizontal="12.dp" />

    <Button
        android:id="@+id/next_button_age"
        android:layout_width="match_parent"
        android:layout_height="40.dp"
        android:layout_marginHorizontal="24.dp"
        android:layout_marginVertical="24.dp"
        android:background="@drawable/custom_button_background"
        android:text="Next Screen"
        android:textAllCaps="false"
        android:textStyle="bold" />
</LinearLayout>