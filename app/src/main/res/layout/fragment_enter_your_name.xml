<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@color/black"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="vertical"
    tools:context=".presentation.shareDataBetweenFrag.EnterYourNameFragment">

    <EditText
        android:id="@+id/enter_your_name"
        android:layout_width="match_parent"
        android:layout_height="56.dp"
        android:layout_marginHorizontal="24.dp"
        android:background="@drawable/custom_edit_text_background"
        android:hint="Enter Your Name"
        android:paddingHorizontal="12.dp" />

    <Button
        android:id="@+id/next_button"
        android:layout_width="match_parent"
        android:layout_height="40.dp"
        android:layout_marginHorizontal="24.dp"
        android:layout_marginVertical="12.dp"
        android:background="@drawable/custom_button_background"
        android:text="Next Screen"
        android:textStyle="bold"
        android:textAllCaps="false" />
</LinearLayout>