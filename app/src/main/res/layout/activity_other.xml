<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.OtherActivity">

    <TextView
        android:id="@+id/tv_screenName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="I am OtherActivity"
        android:textSize="22.sp"
        android:textStyle="bold" />


    <Button
        android:id="@+id/btn_open_fragment_one"
        android:layout_width="match_parent"
        android:layout_height="56.dp"
        android:layout_below="@+id/tv_screenName"
        android:layout_marginHorizontal="64.dp"
        android:layout_marginVertical="24.dp"
        android:background="@color/black"
        android:text="Open Fragment A"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btn_open_fragment_two"
        android:layout_width="match_parent"
        android:layout_height="56.dp"
        android:layout_marginHorizontal="64.dp"
        android:layout_marginVertical="24.dp"
        android:background="@color/black"
        android:text="Open Fragment B"
        android:layout_below="@+id/btn_open_fragment_one"
        android:textColor="@color/white" />


    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/btn_open_fragment_two"
        />
</RelativeLayout>